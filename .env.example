# Local development only. Never commit a real .env file or real keys.
# Select a matching Test OR Live key pair. Do not mix key modes.
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_matching_test_key_secret

# Live order creation remains blocked until final prices are updated and confirmed.
LIVE_PAYMENTS_ENABLED=false
LIVE_PRICES_CONFIRMED=false

# Website origins (not page paths), comma-separated.
FRONTEND_ORIGINS=https://meerannoufal03-oss.github.io,http://127.0.0.1:5500,http://localhost:5500
